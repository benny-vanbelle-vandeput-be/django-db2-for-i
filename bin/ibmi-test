#!/usr/bin/env bash
# bin/ibmi-test: run chosen tests on IBM i (PUB400), through the PUB400 lock.
#
#   bin/ibmi-test own <selector> [...]      own IBM i tests: test ids or pytest options
#                                           (bin/ibmi-test own tests/pub400/test_schema.py,
#                                           bin/ibmi-test own -k goldens)
#   bin/ibmi-test django <label> [...]      Django test modules or ids (--clean), one run per label
#   bin/ibmi-test --full-tier               the full own IBM i tests (needs-full-tier)
#   bin/ibmi-test --django 6.0 ...          another supported Django version (default: the newest)
#   bin/ibmi-test --wait ...                queue behind a running PUB400 job
#   bin/ibmi-test --dry-run ...             print the commands, run nothing
#   bin/ibmi-test --help
#
# The manual request (label run-ibmi). Own tests run with --create-db (a clean
# test library). Never the full Django suite: every Django label is its own
# run, and scripts/runtests.sh refuses a run without labels. --affected (the
# tests bin/verify selects) comes with bin/verify.

source "$(dirname "$0")/_common.sh"
common_args "$@"

django=$(newest_django)
mode= full=0
rest=()
set -- ${ARGS[@]+"${ARGS[@]}"}
while [ $# -gt 0 ]; do
    case $1 in
        --django) django=${2:?--django needs a version}; shift 2 ;;
        --full-tier) full=1; shift ;;
        own | django)
            [ -z "$mode" ] || die "choose one of own / django"
            mode=$1
            shift
            ;;
        *)
            [ -n "$mode" ] || die "unknown argument: $1 (see --help)"
            rest+=("$1")
            shift
            ;;
    esac
done
nox_combinations | awk '{ print $2 }' | grep -qx "$django" || die "Django $django is not supported (noxfile.py)"

if [ "$full" = 1 ]; then
    [ -z "$mode" ] || die "--full-tier runs all own IBM i tests; no own/django selection"
    pub400 pub400 "$django" --create-db
    exit
fi
case $mode in
    own)
        [ "${#rest[@]}" -gt 0 ] || die "name the tests (or use --full-tier)"
        pub400 pub400 "$django" --create-db "${rest[@]}"
        ;;
    django)
        [ "${#rest[@]}" -gt 0 ] || die "name the Django test labels (never the full suite)"
        for label in "${rest[@]}"; do
            run "$ROOT/scripts/runtests.sh" "$django" --clean "$label"
        done
        ;;
    *) die "choose own, django or --full-tier (see --help)" ;;
esac
