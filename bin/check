#!/usr/bin/env bash
# bin/check: what CI does, locally, in the container. Never connects to an IBM i.
#
#   bin/check                              everything, every Python x Django combination
#   bin/check --django 6.1                 one Django version, every Python
#   bin/check --python 3.14 --django 6.1   one combination
#   bin/check --dry-run                    print the commands, run nothing
#   bin/check --help
#
# Runs lint, the offline tier and the corpus replay (nox -s lint offline
# replay), then the verification gate (nox -s gate), then shows the branch's
# classification against origin/main (scripts/classify_pr.py; fetch first for
# an up-to-date origin/main).
#
# Exit codes: 0 all passed; 1 lint, offline or corpus failed; 3 only the
# verification gate failed: a pull request with new SQL may still be pushed
# (CLAUDE.md needs lint and offline before a push), it stays red in CI until
# the stamps of its IBM i run are committed.

source "$(dirname "$0")/_common.sh"
common_args "$@"

python= django=
set -- ${ARGS[@]+"${ARGS[@]}"}
while [ $# -gt 0 ]; do
    case $1 in
        --python) python=${2:?--python needs a version}; shift 2 ;;
        --django) django=${2:?--django needs a version}; shift 2 ;;
        *) die "unknown argument: $1 (see --help)" ;;
    esac
done

sessions=(lint)
found=0
while read -r p d; do
    if [ -n "$python" ] && [ "$p" != "$python" ]; then continue; fi
    if [ -n "$django" ] && [ "$d" != "$django" ]; then continue; fi
    sessions+=("offline($p-django$d)" "replay($p-django$d)")
    found=1
done < <(nox_combinations)
[ "$found" = 1 ] || die "no combination for --python '${python}' --django '${django}' in noxfile.py"

container nox -s "${sessions[@]}" || exit 1
gate=0
container nox -s gate || gate=$?
container uv run --no-project python scripts/classify_pr.py --base origin/main || true
if [ "$gate" != 0 ]; then
    echo "bin/check: only the verification gate failed (see above): run bin/verify or request run-ibmi" >&2
    exit 3
fi
