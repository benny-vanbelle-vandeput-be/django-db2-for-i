#!/usr/bin/env bash
# bin/probe: run read-only IBM i probes by name, through the PUB400 lock.
#
#   bin/probe --list             the probes of probes/run.py (no connection)
#   bin/probe <name> [<name>]    e.g. bin/probe reachability, bin/probe sysinfo libraries
#   bin/probe --wait <name>      queue behind a running PUB400 job
#   bin/probe --dry-run <name>   print the command, run nothing
#   bin/probe --publish <file>   copy a result (test-results/probes/<probe>-<utc>.json)
#                                to probes/results/<probe>.json without host, user
#                                or library names (scripts/publish_probe_result.py)
#   bin/probe --help
#
# Probes are read-only, or change only QTEMP (CLAUDE.md). The write probes
# (nox sessions probe_*, outside QTEMP) need the maintainer's approval first
# and are not run by this script. Results: test-results/probes/ (gitignored);
# publish the ones a decision rests on (CLAUDE.md).

source "$(dirname "$0")/_common.sh"
common_args "$@"

probes() {
    python3 - "$ROOT/probes/run.py" <<'PY'
import ast
import sys

for node in ast.parse(open(sys.argv[1]).read()).body:
    if isinstance(node, ast.Assign) and any(
        isinstance(t, ast.Name) and t.id == "PROBES" for t in node.targets
    ):
        for key in node.value.keys:
            print(ast.literal_eval(key))
PY
    echo all
}

names=()
if [ "${ARGS[0]:-}" = --publish ]; then
    [ "${#ARGS[@]}" = 2 ] || die "--publish needs one result file"
    file=${ARGS[1]}
    file=${file#"$ROOT"/}
    [ -f "$ROOT/$file" ] || [ "$DRY_RUN" = 1 ] || die "no such result: $file"
    container uv run --no-project python scripts/publish_probe_result.py "$file"
    exit
fi
for arg in ${ARGS[@]+"${ARGS[@]}"}; do
    case $arg in
        --list)
            probes
            exit 0
            ;;
        -*) die "unknown argument: $arg (see --help)" ;;
        *) names+=("$arg") ;;
    esac
done
[ "${#names[@]}" -gt 0 ] || die "name a probe (bin/probe --list)"
known=$(probes)
for name in "${names[@]}"; do
    printf '%s\n' "$known" | grep -qx "$name" || die "unknown probe: $name (bin/probe --list)"
done
pub400 probe "${names[@]}"
