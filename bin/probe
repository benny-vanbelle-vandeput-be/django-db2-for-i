#!/usr/bin/env bash
# bin/probe: run IBM i probes by name, through the PUB400 lock.
#
#   bin/probe --list             the probes of probes/run.py and the lib_ probes (no connection)
#   bin/probe <name> [<name>]    e.g. bin/probe reachability, bin/probe sysinfo libraries
#   bin/probe --approved <link> lib_<topic> [--execute] [-- <probe options>]
#                                a probe that changes the IBM i outside QTEMP: only with
#                                the maintainer's approval comment for that probe, checked
#                                on GitHub (scripts/probe_approval.py); dry run without
#                                --execute; the link is stored with the result
#   bin/probe --wait <name>      queue behind a running PUB400 job
#   bin/probe --dry-run <name>   print the command, run nothing
#   bin/probe --publish <file>   copy a result (test-results/probes/<probe>-<utc>.json)
#                                to probes/results/<probe>.json without host, user
#                                or library names (scripts/publish_probe_result.py)
#   bin/probe --help
#
# qtemp_ probes are read-only or change only QTEMP; lib_ probes change a
# library and run only with --approved (CLAUDE.md, "Initial test system:
# PUB400"). Results: test-results/probes/ (gitignored); publish the ones a
# decision rests on (CLAUDE.md).

source "$(dirname "$0")/_common.sh"
common_args "$@"

probes() {
    python3 - "$ROOT/probes/run.py" <<'PY'
import ast
import sys

for node in ast.parse(open(sys.argv[1]).read()).body:
    if isinstance(node, ast.Assign) and any(
        isinstance(t, ast.Name) and t.id == "PROBES" for t in node.targets
    ):
        for key in node.value.keys:
            print(ast.literal_eval(key))
PY
    echo all
    local file
    for file in "$ROOT"/probes/lib_*.py; do
        file=${file##*/}
        echo "${file%.py}"
    done
}

names=()
if [ "${ARGS[0]:-}" = --publish ]; then
    [ "${#ARGS[@]}" = 2 ] || die "--publish needs one result file"
    file=${ARGS[1]}
    file=${file#"$ROOT"/}
    [ -f "$ROOT/$file" ] || [ "$DRY_RUN" = 1 ] || die "no such result: $file"
    container uv run --no-project python scripts/publish_probe_result.py "$file"
    exit
fi
approved=""
lib=""
extra=()
i=0
while [ "$i" -lt "${#ARGS[@]}" ]; do
    arg=${ARGS[$i]}
    case $arg in
        --list)
            probes
            exit 0
            ;;
        --approved)
            i=$((i + 1))
            approved=${ARGS[$i]:-}
            [ -n "$approved" ] || die "--approved needs the link to the approval comment"
            ;;
        --execute) extra+=("$arg") ;;
        --)
            # The rest goes to the lib_ probe itself (e.g. -- --library other).
            extra+=("${ARGS[@]:$((i + 1))}")
            break
            ;;
        -*) die "unknown argument: $arg (see --help)" ;;
        lib_*)
            [ -z "$lib" ] || die "one lib_ probe per run"
            lib=$arg
            ;;
        *) names+=("$arg") ;;
    esac
    i=$((i + 1))
done
if [ -n "$lib" ]; then
    [ "${#names[@]}" = 0 ] || die "a lib_ probe runs alone"
    [ -f "$ROOT/probes/$lib.py" ] || die "unknown probe: $lib (bin/probe --list)"
    [ -n "$approved" ] \
        || die "$lib changes the IBM i outside QTEMP: it needs --approved <link to the maintainer's approval comment for this probe> (CLAUDE.md)"
    if [ "$DRY_RUN" = 1 ]; then
        approver="<checked on GitHub>"
    else
        approver=$(python3 "$ROOT/scripts/probe_approval.py" "$approved") \
            || die "the approval could not be confirmed; nothing was run"
    fi
    pub400 probe_lib "$lib" --approved "$approved" --approved-by "$approver" ${extra[@]+"${extra[@]}"}
    exit
fi
[ -z "$approved" ] && [ "${#extra[@]}" = 0 ] || die "--approved and --execute are for lib_ probes only"
[ "${#names[@]}" -gt 0 ] || die "name a probe (bin/probe --list)"
known=$(probes)
for name in "${names[@]}"; do
    printf '%s\n' "$known" | grep -qx "$name" || die "unknown probe: $name (bin/probe --list)"
done
pub400 probe "${names[@]}"
