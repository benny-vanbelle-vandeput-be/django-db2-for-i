{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env*)",
      "Bash(source .env*)",
      "Bash(. .env*)",
      "Bash(ls *.env*)",
      "Bash(mv *.env*)",
      "Bash(cp *.env*)",
      "Bash(rm *.env*)",
      "Bash(unlink *.env*)",
      "Bash(ln -f*)",
      "Bash(ln -sf*)",
      "Bash(ln -fs*)",
      "Bash(ln -snf*)",
      "Bash(ln -sfn*)",
      "Bash(docker compose config*)",
      "Bash(docker compose run * env)",
      "Bash(docker compose run * printenv*)",
      "Bash(gh workflow run ibmi-gate*)",
      "Bash(gh workflow run *ibmi-gate*)",
      "Bash(gh api *ibmi-gate.yml/dispatches*)"
    ]
  }
}
