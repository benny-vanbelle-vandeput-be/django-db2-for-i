{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env*)",
      "Bash(source .env*)",
      "Bash(. .env*)",
      "Bash(docker compose config*)",
      "Bash(docker compose run * env)",
      "Bash(docker compose run * printenv*)"
    ]
  }
}
