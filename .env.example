# Copy to .env (gitignored) and fill in. Never commit .env.
# compose.yaml injects these into the "tests" container.

DB2I_HOST=pub400.com
DB2I_USER=
DB2I_PASSWORD=

# 1 = TLS on port 9471 (default). 0 = plain on port 8471: the password is sent
# unencrypted. Only set 0 as a deliberate decision.
DB2I_SSL=1

# Existing libraries for the "default" and "other" databases (max 10 chars).
# Run "nox -s probe -- libraries" to list candidates, then fill these in.
DB2I_DEFAULT_LIBRARY=
DB2I_OTHER_LIBRARY=
